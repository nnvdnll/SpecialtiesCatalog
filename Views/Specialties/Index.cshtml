@model IEnumerable<WebApi1.Models.Specialty>
@using System.Linq
@using WebApi1
@using WebApi1.Models

@{
    ViewData["Title"] = "Специальности";
}

<div class="container mt-4">
    <!-- Заголовок и кнопка добавления -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Академические   специальности</h1>      
        <a asp-action="Create" class="btn btn-success">+ Добавить специальность</a>
    </div>


    <!-- ФОРМА ПОИСКА (ФИЛЬТРАЦИИ) -->
    <form asp-action="Index" method="get" class="mb-4">
        <div class="input-group">
            <input type="text" name="searchString" class="form-control" placeholder="Поиск по шифру или названию..." />
            <button type="submit" class="btn btn-outline-primary">Найти</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Сбросить</a>
        </div>
    </form>

    <!-- Единый блок проверки наличия элементов -->
    @{
        bool hasItems = Model != null && Model.Any();
    }

    @if (!hasItems)
    {
        <div class="alert alert-warning text-center py-4" role="alert">
            <h4 class="alert-heading">Ничего не найдено</h4>
            <p>По вашему запросу ничего не найдено. Попробуйте изменить текст поиска или сбросить фильтр.</p>
            <a asp-action="Index" class="btn btn-outline-secondary mt-2">Сбросить поиск</a>
        </div>
    }
    else
    {
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Шифр</th>
                    <th>Название</th>
                    <th>Описание</th>
                    <th>Срок обучения (лет)</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Code</td>
                        <td>@item.Name</td>
                        <td>@item.Description</td>
                        <td>@item.DurationYears</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Изменить</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Удалить</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
<!-- Пагинация -->
@if (ViewBag.TotalPages > 1)
{
    <nav aria-label="Навигация по страницам" class="mt-4">
        <ul class="pagination justify-content-center">

            <!-- Кнопка "Назад" -->
            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-searchString="@ViewBag.SearchString">
                    Назад
                </a>
            </li>

            <!-- Цифры страниц -->
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchString="@ViewBag.SearchString">
                        @i
                    </a>
                </li>
            }

            <!-- Кнопка "Вперед" -->
            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-searchString="@ViewBag.SearchString">
                    Вперед
                </a>
            </li>

        </ul>
    </nav>
}